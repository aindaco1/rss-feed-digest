{
  "name": "rss-feed-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm test && npm run validate:feeds && npm run test:jev",
    "test:jev": "node scripts/jev-evaluation.js",
    "audit:feeds": "node src/feeds/auditFeeds.js",
    "check:env": "node src/config/checkEnvironment.js",
    "digest": "node src/digest/runDigest.js",
    "digest:test": "node src/digest/runDigest.js --test-window --dry-run",
    "digest:send": "node src/digest/runDigest.js --send",
    "feedbin:sync": "node src/feeds/syncFeedbinSubscriptions.js",
    "overcast:sync": "node src/feeds/syncOvercastSubscriptions.js",
    "youtube:authorize": "node src/feeds/authorizeYouTube.js",
    "youtube:sync": "node src/feeds/syncYouTubeSubscriptions.js",
    "test": "npm run worker:build && node --test test/*.test.js",
    "validate:feeds": "node src/feeds/validateFeeds.js",
    "render:sample": "node src/email/renderDigestEmail.js",
    "worker:build": "wrangler deploy --dry-run --outdir out/worker-build"
  },
  "devDependencies": {
    "@dustwave/test-core": "file:shared/dust-wave-platform/packages/test-core",
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@dustwave/worker-core": "file:shared/dust-wave-platform/packages/worker-core",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "openai": "^6.39.1",
    "rss-parser": "^3.13.0"
  }
}
